{
  "name": "upload-labs",
  "version": "14.2.0",
  "description": "Upload Labs: Network Empire - A cyberpunk network management idle game",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.uploadlabs.networkempire",
    "productName": "Upload Labs - Network Empire",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "keywords": [
    "game",
    "idle",
    "network",
    "cyberpunk",
    "incremental"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.38",
    "serve": "^14.2.0",
    "tailwindcss": "^3.4.4",
    "vite": "^7.3.1"
  }
}
