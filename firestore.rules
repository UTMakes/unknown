rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /saves/{userId} {
      // Anyone logged in can read their own save
      allow read: if isOwner(userId);
      
      // Validation for writing a save
      allow write: if isOwner(userId)
                   // Must have required top-level fields
                   && request.resource.data.keys().hasAll(['game', 'version', 'timestamp'])
                   // Game object must exist
                   && request.resource.data.game != null
                   // Money and RP must be valid numbers (prevent NaN or Negative Infinity from breaking the DB)
                   // We allow 0, but no negatives
                   && request.resource.data.game.money is number
                   && request.resource.data.game.money >= 0
                   && request.resource.data.game.rp is number
                   && request.resource.data.game.rp >= 0;
    }
  }
}
